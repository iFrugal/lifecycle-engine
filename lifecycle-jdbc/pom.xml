  <artifactId>lifecycle-jdbc</artifactId>
  <name>lifecycle-jdbc</name>
  <description>JDBC backend (DD-07, DD-11): state, inbox, audit and outbox in one transaction on a plain DataSource, plus a stored rule set source and a task store.</description>

  <properties>
